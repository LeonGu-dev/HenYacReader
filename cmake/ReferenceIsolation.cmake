# Reference snapshots are deliberately outside every build target, including tests.
function(yacreader_check_reference_isolation directory)
    get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    foreach(target IN LISTS targets)
        foreach(property SOURCES INTERFACE_SOURCES INCLUDE_DIRECTORIES INTERFACE_INCLUDE_DIRECTORIES)
            get_target_property(inputs "${target}" "${property}")
            foreach(input IN LISTS inputs)
                file(TO_CMAKE_PATH "${input}" normalized)
                if(normalized MATCHES "(^|/)legacy(/|$)")
                    message(FATAL_ERROR "Reference isolation: ${target} ${property} includes ${input}")
                endif()
            endforeach()
        endforeach()
    endforeach()
    get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(child IN LISTS children)
        yacreader_check_reference_isolation("${child}")
    endforeach()
endfunction()
